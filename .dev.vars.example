# Local-only env (this file is gitignored).
# Auth is in-app Google OAuth: /api/auth/google -> Google -> /api/auth/google/callback.
# On localhost, when GOOGLE_CLIENT_ID/SECRET are unset, this email is signed in
# directly so `pnpm dev` and e2e need no Google credentials.
LOCAL_DEV_USER_EMAIL=you@example.com

# Real Google sign-in locally: create a Web application OAuth client and add
# http://localhost:5173/api/auth/google/callback as an authorized redirect URI.
# Production: `wrangler secret put GOOGLE_CLIENT_ID` / `GOOGLE_CLIENT_SECRET`.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# HMAC key for the session cookie. Required in production
# (`wrangler secret put SESSION_SECRET`, e.g. `openssl rand -hex 32`).
# On localhost a fixed dev key is used when this is unset.
# SESSION_SECRET=

# Who may use the app (comma-separated). Empty = any verified Google account.
# Keep at least one entry in production.
# ACCESS_ALLOWED_EMAILS=you@example.com

# Native app / scripted access: `Authorization: Bearer <APP_API_TOKEN>` on /api/*.
# Production: `wrangler secret put APP_API_TOKEN` (e.g. `openssl rand -hex 32`).
# APP_API_TOKEN_EMAIL is the identity writes are attributed to; it defaults to a
# single-entry ACCESS_ALLOWED_EMAILS.
# APP_API_TOKEN=
# APP_API_TOKEN_EMAIL=you@example.com

# Premium (AI) entitlement. Comma-separated emails. Unset = every member is
# premium, which is the pre-billing default. See docs/spec/billing.md.
# PREMIUM_EMAILS=you@example.com

# Field encryption stub (not wired to D1 yet). 32-byte hex. Production: wrangler secret.
# FIELD_ENCRYPTION_KEY=

# TypeSafe Jev (System One). When set, create-time auto-tags and AI評価 prefer Jev
# over Workers AI. Production: `wrangler secret put TYPESAFE_API_KEY`. Never commit a real key.
TYPESAFE_API_KEY=

# Remote MCP at /mcp. Shared bearer for Cursor, Claude Desktop, and other agents.
# Production: `wrangler secret put MCP_API_KEY`. MCP_TOKEN is used only when MCP_API_KEY is unset.
# Never commit a real key. See docs/spec/mcp.md.
MCP_API_KEY=

# Optional Brave Search API key for リサーチ 先行事例.
# When unset, research fetches DuckDuckGo/Bing HTML (and DuckDuckGo Instant Answer JSON).
# Production: `wrangler secret put SEARCH_API_KEY`. Never commit a real key.
SEARCH_API_KEY=
