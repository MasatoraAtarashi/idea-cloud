/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Generated by squat. App name is set at scaffold time.
 * Production D1 id is the live idea-cloud-db (APAC). The vitest dummy id
 * stays in wrangler.vitest.jsonc — do not copy it here.
 * See docs/spec/deploy-and-access.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-cloud",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idea-cloud-db",
      // Created 2026-09-16 via Cloudflare bindings (APAC)
      "database_id": "c49e0fd3-b7e4-422e-b3fc-019bf0264dab",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  // Per-idea research + brainstorm stay on Workers AI. Research also fetches a
  // few public web results (DuckDuckGo Lite/HTML, Bing, or Brave when
  // SEARCH_API_KEY is set). Auto-tags + create-time AI評価 prefer TypeSafe Jev
  // when TYPESAFE_API_KEY is set
  // (wrangler secret / .dev.vars; never in git).
  // Local `pnpm dev` disables remote bindings in vite.config.ts so this does not
  // open an OAuth session. Production deploy uses the real Workers AI service.
  "ai": {
    "binding": "AI",
  },
}
