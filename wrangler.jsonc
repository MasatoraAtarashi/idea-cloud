/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Generated by squat. App name is set at scaffold time. Replace D1 database_id
 * on first `wrangler d1 create` / `squat deploy`. See docs/spec/deploy-and-access.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-cloud",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idea-cloud-db",
      // Created 2026-09-16 via Cloudflare bindings (APAC)
      "database_id": "c49e0fd3-b7e4-422e-b3fc-019bf0264dab",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  // Per-idea research + create-time auto-tags (Workers AI). No web search / Browser Rendering.
  // Local `pnpm dev` disables remote bindings in vite.config.ts so this does not
  // open an OAuth session. Production deploy uses the real Workers AI service.
  "ai": {
    "binding": "AI",
  },
}
