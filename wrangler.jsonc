/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Generated by squat. App name is set at scaffold time. Replace D1 database_id
 * on first `wrangler d1 create` / `squat deploy`. See docs/spec/deploy-and-access.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-cloud",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idea-cloud-db",
      // Replaced with the id from `wrangler d1 create` on first deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  /**
   * Add Static Assets / Service Bindings only when the code uses them:
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
}
