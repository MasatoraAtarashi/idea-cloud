/**
 * テスト用の wrangler 設定（vitest-pool-workers が読む）。
 * 本番の wrangler.jsonc とバインディング構成を揃えること。
 * database_id is a dummy on purpose. The live id belongs only in wrangler.jsonc.
 * Workers AI is omitted: the binding forces a remote proxy session, and CI
 * stubs env.AI.run (research, brainstorm) and TypeSafe System One (auto-tags /
 * evaluation) instead of calling models. TYPESAFE_API_KEY and SEARCH_API_KEY
 * are unset in tests; web search is stubbed via setTestWebSearch.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idea-cloud-test",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./test/worker.ts",
  "observability": {
    "enabled": false,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "vars": {
    "MCP_API_KEY": "test-mcp-key",
    "SESSION_SECRET": "test-session-secret",
    "APP_API_TOKEN": "test-app-token",
    "APP_API_TOKEN_EMAIL": "app@example.com",
    // Both test identities land in the legacy workspace (see server/tenant/workspace.ts).
    "ACCESS_ALLOWED_EMAILS": "test@example.com,app@example.com",
    // Billing is "live" in tests so the Stripe paths are exercised; the two test
    // identities are comped so the rest of the suite is not a paying customer.
    "PREMIUM_EMAILS": "test@example.com,app@example.com",
    "STRIPE_SECRET_KEY": "sk_test_dummy",
    "STRIPE_PRICE_ID": "price_test",
    "STRIPE_WEBHOOK_SECRET": "whsec_test",
  },
}
